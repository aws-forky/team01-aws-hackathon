# API 설정
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000

# 개발 환경 설정
VITE_NODE_ENV=development
VITE_DEBUG_MODE=true

# 음성 인식 설정
VITE_SPEECH_RECOGNITION_LANG=ko-KR
VITE_SPEECH_RECOGNITION_TIMEOUT=10000

# PDF 생성 설정
VITE_PDF_MAX_SIZE=50MB
VITE_PDF_QUALITY=high

# 로깅 설정
VITE_LOG_LEVEL=info
VITE_ENABLE_API_LOGGING=true